{
	"name": "@nxgt/zod",
	"version": "0.0.0",
	"private": true,
	"description": "Shared Zod 4 building blocks for nxgt: scalar schemas for IBAN, UUID, DateTime, IP and 60 more formats, the rules @nxgt/graphql-scalars applies",
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"docs",
		"README.md",
		"package.json",
		"LICENSE"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./scalars": {
			"types": "./dist/scalars/index.d.ts",
			"import": "./dist/scalars/index.js",
			"default": "./dist/scalars/index.js"
		},
		"./package.json": "./package.json"
	},
	"keywords": [
		"zod",
		"zod4",
		"schema",
		"validation",
		"scalars",
		"iban",
		"uuid",
		"typescript"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/softistx/nxgt-zod.git",
		"directory": "packages/zod"
	},
	"publishConfig": {
		"registry": "https://registry.npmjs.org",
		"access": "public"
	},
	"scripts": {
		"build": "bun run ../../build.ts",
		"test": "bun test src",
		"typecheck": "tsc --noEmit"
	},
	"nxgt": {
		"entrypoints": [
			"src/index.ts",
			"src/scalars/index.ts"
		]
	},
	"devDependencies": {
		"@types/bun": "^1.4.0",
		"zod": "4.6.5"
	},
	"peerDependencies": {
		"typescript": "^6.0.3",
		"zod": ">=4.6.5 <5"
	}
}
